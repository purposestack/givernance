# =============================================================================
# Givernance — Local Development Environment
# Copy to .env and adjust as needed:  cp .env.example .env
# =============================================================================

# --- PostgreSQL -------------------------------------------------
# One Postgres instance, one logical database per tool (ADR-017).
# `givernance`           — application data (Drizzle-managed schema)
# `givernance_keycloak`  — Keycloak 24's internal tables, owned by `keycloak`
POSTGRES_DB=givernance
POSTGRES_USER=givernance
POSTGRES_PASSWORD=givernance_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://givernance:givernance_dev@localhost:5432/givernance
# App role for API (subject to RLS — do NOT use for workers/relay)
DATABASE_URL_APP=postgresql://givernance_app:givernance_app_dev@localhost:5432/givernance
# Password for the `givernance_app` runtime role — consumed by the
# postgres init script (02-init-givernance-app-role.sh) on first
# container boot. MUST match the password embedded in DATABASE_URL_APP
# above. Rotate one → rotate the other.
GIVERNANCE_APP_PASSWORD=givernance_app_dev
# Keycloak's own database + owner role. Provisioned on first `docker compose
# up -d` by infra/postgres/init/01-init-keycloak-db.sh.
KEYCLOAK_DB_NAME=givernance_keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak_dev

# --- Redis (cache / rate-limiting / BullMQ) ---------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Keycloak (OIDC / SAML) ------------------------------------
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Keycloak base URL and realm — consumed by the web app's server-side OIDC flow
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=givernance
# OIDC client credentials — must match infra/keycloak/realm-givernance.json
KEYCLOAK_CLIENT_ID=givernance-web
KEYCLOAK_CLIENT_SECRET=ci-test-secret-do-not-use-in-production
KEYCLOAK_ISSUER=http://localhost:8080/realms/givernance
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/givernance/protocol/openid-connect/certs
# Service-account client used by the API for Keycloak Admin API calls (ADR-016 / issue #107).
# `KEYCLOAK_ADMIN_URL` defaults to `KEYCLOAK_URL`; set it only when fronted separately.
# Leave `KEYCLOAK_ADMIN_CLIENT_SECRET` unset to disable the admin client (endpoints that
# need it will return a typed error rather than crash at boot).
KEYCLOAK_ADMIN_CLIENT_ID=givernance-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=ci-test-admin-secret-do-not-use-in-production
# KEYCLOAK_ADMIN_URL=http://localhost:8080
# TOTP QR-code issuer label. Authenticator apps render this as the
# account header — distinguishes credentials enrolled against dev /
# staging / prod when the same operator uses one app across envs.
# Conventional values: givernance-dev / givernance-staging / givernance.
# Read by `scripts/keycloak-sync-realm.sh` and applied as
# `realm.displayName`. Empty / unset leaves the realm displayName as-is.
KC_REALM_DISPLAY_NAME=givernance-dev

# --- Auth -------------------------------------------------------
# `KEYCLOAK_ISSUER` / `KEYCLOAK_JWKS_URL` are optional explicit overrides.
# Leave them aligned with the realm unless you front Keycloak elsewhere.

# Step-up MFA gate on POST /v1/admin/impersonation (issue #250).
# When `true`, the API rejects starts that don't carry `acr >= 2` and a
# fresh `auth_time`, sending the operator through Keycloak's Conditional-
# LoA-2 sub-flow (TOTP enrolment on first attempt, OTP prompt thereafter).
# Required `true` in production — env.ts boot check fails fast otherwise.
# Defaults `false` in dev so a normal `/admin/impersonation/new` round-
# trip works without provisioning an authenticator app. Flip to `true`
# locally when you want to exercise the full step-up flow against the
# realm config installed by `scripts/keycloak-sync-realm.sh`.
IMPERSONATION_REQUIRE_ACR_2=false

# --- Admin ------------------------------------------------------
# Secret header required for platform-admin routes (POST /v1/tenants, etc.)
ADMIN_SECRET=change-me-in-production

# --- SeaweedFS (S3-compatible object storage, ADR-034) ----------
# Replaces MinIO (maintenance-mode since Dec 2025). Single-node
# `weed server -s3` exposes the S3 API on 8333 (MinIO used 9000) and a
# filer browser UI on 8888 (replaces the removed MinIO Console).
# Production (SaaS) is unaffected — it uses Scaleway Object Storage (ADR-009).
S3_PORT=8333
SEAWEEDFS_FILER_PORT=8888
# SSE-S3 Key-Encryption-Key. SeaweedFS derives the envelope-encryption
# master key from this passphrase (HKDF) so the worker's
# `ServerSideEncryption: "AES256"` uploads succeed. Replaces
# MINIO_KMS_SECRET_KEY. Local-only throwaway. Must stay STABLE across
# restarts wherever data persists (staging) or encrypted objects become
# unreadable.
SEAWEEDFS_SSE_KEY=givernance-dev-sse-kek-do-not-use-in-prod
S3_ENDPOINT=http://localhost:8333
# Must match the credentials in infra/seaweedfs/s3config.json.
S3_ACCESS_KEY_ID=givernance
S3_SECRET_ACCESS_KEY=givernance_dev
S3_REGION=fr-par
S3_RECEIPTS_BUCKET=receipts
S3_CAMPAIGNS_BUCKET=campaigns
# Super-admin monthly platform finance reports (issue #443) — private
# bucket, streamed back through the API. ADR-023.
S3_REPORTS_BUCKET=reports
# Org-branding bucket (Epic #286) — public-read so the Keycloak login
# template and donation pages can serve logos without a signed-URL hop.
# Objects are content-addressed under `{org_id}/logo/{logo_id}/{variant}.{ext}`.
S3_BRANDING_BUCKET=branding
# Override only when the public branding URL is fronted separately
# (CDN). Defaults to `${S3_ENDPOINT}/${S3_BRANDING_BUCKET}` — fine for
# local dev against MinIO. The Keycloak login template enforces HTTPS-
# only on the rendered logo URL (M1 guard), so production MUST set this
# to an HTTPS origin.
# KEYCLOAK_LOGO_PUBLIC_URL_BASE=https://cdn.givernance.eu/branding

# --- Receipt envelope encryption (issue #228) --------------------
# Only needed once the `donation.receipt_envelope_encryption` feature
# flag is ON. With the flag on, the worker seals each NEW receipt PDF
# with a per-receipt DEK (AES-256-GCM) and wraps that DEK with the KEK
# configured here; the API unwraps + decrypts on download. Flag on +
# missing/invalid config = receipt jobs FAIL (fail-closed by design —
# never a silent plaintext fallback), so set these BEFORE flipping the
# flag. Same values go to BOTH the api and the worker.
#
# Provider: `local` (dev / staging / self-hosted JSON keyring) or
# `scaleway` (Scaleway Key Manager — SaaS prod).
# RECEIPT_ENCRYPTION_KEK_PROVIDER=local
#
# Local keyring: JSON map of version-id → base64 32-byte key. Generate
# a key with: `openssl rand -base64 32`. DO-NOT-USE-IN-PROD — the
# example value below is a throwaway for local dev only. Rotation = add
# "v2", flip the active version, run
# `pnpm --filter @givernance/worker run rewrap:trigger`.
# RECEIPT_ENCRYPTION_LOCAL_KEYRING={"v1":"9BAFXWnRuUxPTHUpZC3NcHLbcIRq7n8wxCbkbhL0Bx0="}
# RECEIPT_ENCRYPTION_LOCAL_ACTIVE_VERSION=v1
#
# Scaleway Key Manager (SaaS prod) — key UUID + IAM secret key.
# RECEIPT_ENCRYPTION_SCW_KEY_ID=
# RECEIPT_ENCRYPTION_SCW_SECRET_KEY=
# RECEIPT_ENCRYPTION_SCW_REGION=fr-par
# RECEIPT_ENCRYPTION_SCW_ENDPOINT=https://api.scaleway.com

# --- Email --------------------------------------------------------
# Worker email backend. Defaults to `mailpit` for local dev (the SMTP
# block below). Staging/prod set `resend` to dispatch via Resend's HTTP
# API; in that case `RESEND_API_KEY` must also be set.
EMAIL_PROVIDER=mailpit
EMAIL_FROM=Givernance <no-reply@givernance.local>
# Resend API key — required when EMAIL_PROVIDER=resend (staging/prod).
# Issue #190 / docs/05 §3.1.
# RESEND_API_KEY=

# --- Mailpit (local SMTP testing) ------------------------------
# Browse sent mail at http://localhost:8025.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
# Leave SMTP_USER / SMTP_PASS empty for Mailpit (it rejects AUTH).
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM is the legacy alias for EMAIL_FROM — still read as a
# fallback. New setups should set EMAIL_FROM above instead.
# SMTP_FROM=Givernance <no-reply@givernance.local>

# --- App --------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug
# Public URL of the Next.js app — used by the API for CORS and by the web for OIDC redirects
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# API base URLs (ADR-011): internal server-to-server vs browser via public gateway
# API_URL uses 127.0.0.1 (not localhost) so Node's fetch/undici doesn't race IPv6
# ::1 against IPv4 127.0.0.1 — the API binds on 0.0.0.0 (IPv4 only), so ::1 fails.
API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# --- Stripe Connect ---------------------------------------------
# Test-mode platform credentials. See docs/dev/stripe-local-setup.md.
# STRIPE_SECRET_KEY        — server: API calls to Stripe (Connect onboarding,
#                            PaymentIntents). Never expose to the browser.
# STRIPE_WEBHOOK_SECRET    — server: Stripe-Signature verification. From
#                            `stripe listen`, NOT the dashboard.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY — browser: Stripe.js Payment Element.
#                            From dashboard.stripe.com/test/apikeys.
# STRIPE_SECRET_KEY=sk_test_your_key_here
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# --- Exchange rates ----------------------------------------------
# EXCHANGE_RATE_API_KEY=your_exchangerate_api_key_here

# --- Relay (outbox poller) --------------------------------------
OUTBOX_POLL_INTERVAL_MS=500

# --- NATS (Phase 4+, not required for local dev) ----------------
# NATS_URL=ws://localhost:4222
