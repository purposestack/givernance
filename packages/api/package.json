{
  "name": "@givernance/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:local": "tsx --env-file=../../.env scripts/seed.ts",
    "db:seed:funds": "tsx --env-file=../../.env scripts/seed-funds.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@aws-sdk/lib-storage": "^3.1148.0",
    "@aws-sdk/s3-request-presigner": "^3.1148.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@givernance/shared": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "archiver": "^7.0.1",
    "bullmq": "^5.80.2",
    "csv-parse": "^7.0.3",
    "dompurify": "^3.4.16",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "file-type": "^22.1.1",
    "ioredis": "^5.11.1",
    "jose": "^6.2.12",
    "jsdom": "^29.1.1",
    "nats.ws": "^1.29.2",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pino": "10.4.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "stripe": "^22.2.0",
    "swissqrbill": "^4.4.2"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.6.4",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
