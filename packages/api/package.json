{
  "name": "@givernance/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:local": "tsx --env-file=../../.env scripts/seed.ts",
    "db:seed:funds": "tsx --env-file=../../.env scripts/seed-funds.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1067.0",
    "@aws-sdk/lib-storage": "^3.1067.0",
    "@aws-sdk/s3-request-presigner": "^3.1067.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.6",
    "@givernance/shared": "workspace:*",
    "@sinclair/typebox": "^0.34.12",
    "archiver": "^7.0.1",
    "bullmq": "^5.78.0",
    "csv-parse": "^6.2.1",
    "dompurify": "^3.4.9",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.0.1",
    "file-type": "^22.0.1",
    "ioredis": "^5.11.1",
    "jose": "^6.2.3",
    "jsdom": "^29.1.1",
    "lru-cache": "^11.5.1",
    "nats.ws": "^1.29.2",
    "pdfkit": "^0.19.1",
    "pg": "^8.21.0",
    "pino": "10.3.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.1",
    "stripe": "^22.2.0",
    "swissqrbill": "^4.3.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.3",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
