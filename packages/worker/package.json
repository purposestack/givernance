{
  "name": "@givernance/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch --env-file=../../.env src/worker.ts",
    "digest:trigger": "tsx --env-file=../../.env scripts/trigger-notification-digest.ts",
    "rewrap:trigger": "tsx --env-file=../../.env scripts/trigger-rewrap-receipt-deks.ts",
    "start": "node dist/worker.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1115.0",
    "@aws-sdk/lib-storage": "^3.1115.0",
    "@givernance/shared": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "archiver": "^7.0.1",
    "bullmq": "^5.80.2",
    "csv-parse": "^7.0.2",
    "dompurify": "^3.4.14",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "ioredis": "^5.11.1",
    "jsdom": "^29.1.1",
    "nodemailer": "^9.0.5",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "resend": "^6.21.0",
    "sharp": "^0.35.3",
    "stripe": "^22.5.0",
    "swissqrbill": "^4.4.1"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/jsdom": "^28.0.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
